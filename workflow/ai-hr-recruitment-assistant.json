        "messages": {
          "messageValues": [
            {
              "message": "=You are an HR expert and you need to understand if the candidate aligns with the profile sought by the company. You must give a score from 1 to 10, where 1 means the candidate does not align with what is required, while 10 means they are the ideal candidate because they fully reflect the desired profile. Return the score in the 'ai_resume_score' field. Furthermore, in the 'ai_evaluation' field, explain the reasoning behind your score."
            }
          ]
        },
        "batching": {}
